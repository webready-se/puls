#!/usr/bin/env php
<?php
/**
 * Puls CLI
 *
 * Usage:
 *   php puls user:add <name> [--sites=a,b]       Add a user
 *   php puls user:edit [<name>]                   Edit user (sites, password)
 *   php puls user:remove [<name>] [--yes]        Remove a user
 *   php puls user:list                           List all users
 *   php puls sites:list                          List all tracked sites
 *   php puls sites:rename [<old> <new>] [--merge]   Rename a site (--merge: into one that has visits)
 *   php puls sites:remove [<name>] [--yes]         Delete all data for a site
 *   php puls sites:group [<group> <site>...] [--new]  Put sites in a group (--new: before their first visit)
 *   php puls sites:ungroup [<site>...]             Take sites out of their group
 *   php puls sites:clean-paths [<site>] [--query|--keep=a,b] [--ids] [--tokens] [--dry-run]  Clean stored paths
 *   php puls share:create [<site or group>] [--groups=a,b] [--label=...] [--expires=YYYY-MM-DD|never]  Create a read token
 *   php puls share:list [<site>]                  List share tokens
 *   php puls share:edit [<token>] [--label=...|none] [--expires=YYYY-MM-DD|never] [--groups=a,b]  Change a token, which stays the same
 *   php puls share:revoke [<token>] [--yes]        Revoke a share token
 *   php puls exclude:add [<site> <ip>] [--label=...]  Stop counting an IP or range (site * = all sites)
 *   php puls exclude:list [<site>]                 List excluded IPs
 *   php puls exclude:remove [<site> <ip>]          Count an excluded IP again
 *   php puls nginx:config                          Generate Nginx config for a site
 *   php puls stats:build                           Sum every finished day for the dashboard at once
 *   php puls bots:unknown [<site>] [--days=30]     The user agents behind visits Puls has no name for
 *   php puls posts:add --json                      Add a post, as JSON on stdin, to show on its day
 *   php puls posts:list [<site>] [--days=30]       List the latest posts
 *   php puls posts:remove [<id>] [--yes]           Remove a post
 *   php puls backup [<dir>] [--keep=7]             A checked, compressed copy of the database
 */

$config = require __DIR__ . '/config.php';
// --yes answers a removal's question, so a script can run it; it may stand anywhere
$yes = in_array('--yes', $argv, true);
$argv = array_values(array_filter($argv, fn($arg) => $arg !== '--yes'));
$command = $argv[1] ?? 'help';

if ($warning = old_release_warning(__DIR__)) fwrite(STDERR, $warning);

match ($command) {
    'user:add'      => userAdd($config, $argv[2] ?? null, $argv),
    'user:edit'     => userEdit($config, $argv[2] ?? null),
    'user:remove'   => userRemove($config['users_file'], $argv[2] ?? null, $yes),
    'user:list'     => userList($config['users_file']),
    'sites:list'    => sitesList($config['db_path']),
    'sites:rename'  => sitesRename($config, $argv),
    'sites:remove'  => sitesRemove($config, $argv[2] ?? null, $yes),
    'sites:group'   => sitesGroup($config, $argv),
    'sites:ungroup' => sitesUngroup($config, $argv),
    'sites:clean-paths' => sitesCleanPaths($config, $argv),
    'share:create'  => shareCreate($config, $argv[2] ?? null, $argv),
    'share:list'    => shareList($config, $argv[2] ?? null),
    'share:edit'    => shareEdit($config, $argv),
    'share:revoke'  => shareRevoke($config, $argv[2] ?? null, $yes),
    'exclude:add'   => excludeAdd($config, $argv),
    'exclude:list'  => excludeList($config, $argv[2] ?? null),
    'exclude:remove' => excludeRemove($config, $argv[2] ?? null, $argv[3] ?? null),
    'nginx:config'  => nginxConfig(),
    'stats:build'   => statsBuild($config['db_path']),
    'bots:unknown'  => botsUnknown($config['db_path'], $argv),
    'posts:add'     => postsAdd($config, $argv),
    'posts:list'    => postsList($config, $argv),
    'posts:remove'  => postsRemove($config, $argv[2] ?? null, $yes),
    'backup'        => backup($config, $argv),
    default         => printHelp(),
};

// =====================================================================
// Helpers
// =====================================================================

function prompt(string $label = ''): string
{
    if (function_exists('readline')) {
        return trim(readline($label));
    }
    if ($label !== '') {
        echo $label;
        flush();
    }
    return trim(fgets(STDIN));
}

/**
 * Read a secret. On a terminal the input is hidden; from a pipe it is one line read through
 * prompt() like every other answer, so piped input stays in order.
 */
function promptSecret(string $label): string
{
    echo $label;
    if (!stream_isatty(STDIN)) {
        $value = prompt();
        echo "\n";
        return $value;
    }
    system('stty -echo');
    $value = trim((string) fgets(STDIN));
    system('stty echo');
    echo "\n";
    return $value;
}

/** A password to read out or type on a phone: four groups of five, no look-alikes (about 99 bits). */
function generatePassword(): string
{
    $alphabet = 'abcdefghjkmnpqrstuvwxyz23456789';
    $groups = [];
    for ($g = 0; $g < 4; $g++) {
        $group = '';
        for ($i = 0; $i < 5; $i++) $group .= $alphabet[random_int(0, strlen($alphabet) - 1)];
        $groups[] = $group;
    }
    return implode('-', $groups);
}

/**
 * Ask for a password, or generate one on Enter. A typed one needs 10 characters and, on a
 * terminal, the same again. Exits with 1 when it is too short or does not match.
 */
function askPassword(string $username): string
{
    $password = promptSecret("Password for {$username} (Enter for a generated one): ");
    if ($password === '') {
        $password = generatePassword();
        echo "Generated password: {$password}\n";
        echo "Copy it now: Puls keeps only a hash of it, so it cannot show it again.\n";
        return $password;
    }
    if (strlen($password) < 10) {
        echo "A password needs at least 10 characters. Press Enter instead for a generated one.\n";
        exit(1);
    }
    if (stream_isatty(STDIN) && promptSecret('Same password again: ') !== $password) {
        echo "The two passwords do not match. Nothing was changed.\n";
        exit(1);
    }
    return $password;
}

// =====================================================================
// user:add
// =====================================================================

function userAdd(array $config, ?string $username, array $argv): void
{
    if (!$username) {
        $username = prompt('Username: ');
        if ($username === '') {
            echo "A username is needed: php puls user:add <username> [--sites=a,b]\n";
            exit(1);
        }
    }

    $users = loadUsers($config['users_file']);

    if (isset($users[$username])) {
        echo "User '{$username}' already exists. Use user:edit to modify.\n";
        exit(1);
    }

    $password = askPassword($username);

    // Parse --sites flag
    $sites = null;
    foreach ($argv as $arg) {
        if (str_starts_with($arg, '--sites=')) {
            $sites = array_values(array_filter(explode(',', substr($arg, 8))));
        }
    }

    // Interactive site selection if --sites not provided
    if ($sites === null) {
        $sites = interactiveSiteSelect($config['db_path'], []);
    }

    $users[$username] = [
        'password' => password_hash($password, PASSWORD_BCRYPT, ['cost' => 12]),
        'sites' => $sites,
    ];

    saveUsers($config['users_file'], $users);
    $scope = $sites ? implode(', ', $sites) : 'all sites';
    $url = rtrim($_ENV['APP_URL'] ?? '', '/');
    echo "Added {$username} (access: {$scope})." . ($url ? " Sign in at {$url}" : '') . "\n";
}

// =====================================================================
// user:edit
// =====================================================================

function userEdit(array $config, ?string $username): void
{
    $users = loadUsers($config['users_file']);

    if (empty($users)) {
        echo "No users configured.\n";
        exit(1);
    }

    // Interactive user picker if no argument
    if (!$username) {
        $names = array_keys($users);
        if (count($names) === 1) {
            $username = $names[0];
        } else {
            echo "Select user to edit:\n";
            foreach ($names as $i => $name) {
                $sites = !empty($users[$name]['sites']) ? implode(', ', $users[$name]['sites']) : 'all sites';
                echo sprintf("  %d) %s (%s)\n", $i + 1, $name, $sites);
            }
            $idx = (int) prompt("\nSelect (number): ") - 1;
            if ($idx < 0 || $idx >= count($names)) {
                echo "Invalid selection.\n";
                exit(1);
            }
            $username = $names[$idx];
        }
    }

    if (!isset($users[$username])) {
        echo "User '{$username}' not found.\n";
        exit(1);
    }

    $user = $users[$username];
    $currentSites = $user['sites'] ?? [];
    $scope = $currentSites ? implode(', ', $currentSites) : 'all sites';
    echo "Editing user '{$username}' (current access: {$scope})\n\n";

    // Site selection
    $sites = interactiveSiteSelect($config['db_path'], $currentSites);

    // Password change
    $answer = strtolower(prompt("Change password? (y/N): "));

    if ($answer === 'y' || $answer === 'j') {
        $password = askPassword($username);
        $user['password'] = password_hash($password, PASSWORD_BCRYPT, ['cost' => 12]);
        echo "Password updated.\n";
    }

    $user['sites'] = $sites;
    $users[$username] = $user;

    saveUsers($config['users_file'], $users);
    $scope = $sites ? implode(', ', $sites) : 'all sites';
    echo "User '{$username}' updated (access: {$scope}).\n";
}

// =====================================================================
// user:remove
// =====================================================================

function userRemove(string $file, ?string $username, bool $yes = false): void
{
    $users = loadUsers($file);

    if (empty($users)) {
        echo "No users configured.\n";
        exit(1);
    }

    // Interactive user picker if no argument
    if (!$username) {
        $names = array_keys($users);
        echo "Select user to remove:\n";
        foreach ($names as $i => $name) {
            $sites = !empty($users[$name]['sites']) ? implode(', ', $users[$name]['sites']) : 'all sites';
            echo sprintf("  %d) %s (%s)\n", $i + 1, $name, $sites);
        }
        $idx = (int) prompt("\nSelect (number): ") - 1;
        if ($idx < 0 || $idx >= count($names)) {
            echo "Invalid selection.\n";
            exit(1);
        }
        $username = $names[$idx];
    }

    if (!isset($users[$username])) {
        echo "User '{$username}' not found.\n";
        exit(1);
    }

    if (!$yes) {
        $confirm = strtolower(prompt("Remove user '{$username}'? (y/N): "));
        if ($confirm !== 'y' && $confirm !== 'j') {
            echo "Aborted.\n";
            exit(0);
        }
    }

    unset($users[$username]);
    saveUsers($file, $users);
    echo "User '{$username}' removed.\n";
}

// =====================================================================
// user:list
// =====================================================================

function userList(string $file): void
{
    $users = loadUsers($file);

    if (empty($users)) {
        echo "No users configured. Run: php puls user:add <username>\n";
        return;
    }

    echo sprintf("%-20s %s\n", 'USERNAME', 'SITES');
    echo str_repeat('-', 50) . "\n";
    foreach ($users as $name => $data) {
        $sites = !empty($data['sites']) ? implode(', ', $data['sites']) : 'all sites';
        echo sprintf("%-20s %s\n", $name, $sites);
    }
}

// =====================================================================
// sites:list
// =====================================================================

function sitesList(string $dbPath): void
{
    if (!file_exists($dbPath)) {
        echo "No database found. Start tracking to create it.\n";
        exit(1);
    }

    $db = new PDO('sqlite:' . $dbPath);
    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

    $stmt = $db->query("
        SELECT
            p.site,
            MIN(p.created_at) as first_seen,
            MAX(p.created_at) as last_seen,
            COUNT(*) as pageviews,
            COUNT(DISTINCT p.visitor_hash) as visitors,
            COALESCE(bl.broken_links, 0) as broken_links
        FROM pageviews p
        LEFT JOIN (
            SELECT site, COUNT(*) as broken_links
            FROM broken_links
            GROUP BY site
        ) bl ON bl.site = p.site
        GROUP BY p.site
        ORDER BY p.site
    ");

    $sites = $stmt->fetchAll(PDO::FETCH_ASSOC);

    if (empty($sites)) {
        echo "No sites tracked yet.\n";
        return;
    }

    // The site column is as wide as the longest name needs (indented under a group), with two
    // spaces before the dates, so a long name never runs into them; at least as wide as before
    $groups = siteGroupMap($db);
    $indent = empty($groups) ? 0 : 2;
    $col = max(22, max(array_map(fn($s) => mb_strlen($s['site']), $sites)) + $indent + 2);
    echo mbPad('SITE', $col) . sprintf("%-12s %-12s %10s %10s %8s\n",
        'SINCE', 'LAST SEEN', 'PAGEVIEWS', 'VISITORS', 'BROKEN');
    echo str_repeat('─', $col + 56) . "\n";

    $row = function (array $s, string $indent = '') use ($col): void {
        if (!empty($s['waiting'])) {
            echo mbPad($indent . $s['site'], $col) . "no visits yet\n";
            return;
        }
        echo mbPad($indent . $s['site'], $col) . sprintf("%-12s %-12s %10s %10s %8s\n",
            substr($s['first_seen'], 0, 10),
            substr($s['last_seen'], 0, 10),
            number_format($s['pageviews']),
            number_format($s['visitors']),
            $s['broken_links'] ?: '-'
        );
    };

    // With groups, the sites are listed under their group, the ones without one last
    if (empty($groups)) {
        foreach ($sites as $s) $row($s);
    } else {
        $byGroup = [];
        foreach ($sites as $s) $byGroup[$groups[$s['site']] ?? ''][] = $s;
        // Grouped before its first visit (sites:group --new): listed so a misspelt name shows
        $seen = array_column($sites, 'site');
        foreach ($groups as $site => $g) {
            if (!in_array($site, $seen, true)) $byGroup[$g][] = ['site' => $site, 'waiting' => true];
        }
        $names = array_filter(array_keys($byGroup), fn($g) => $g !== '');
        sort($names, SORT_NATURAL | SORT_FLAG_CASE);
        if (isset($byGroup[''])) $names[] = '';
        foreach ($names as $name) {
            echo ($name === '' ? 'No group' : $name) . "\n";
            foreach ($byGroup[$name] as $s) $row($s, '  ');
        }
    }

    echo "\n" . count($sites) . " site(s) tracked.\n";
}

// =====================================================================
// sites:rename
// =====================================================================

function sitesRename(array $config, array $argv): void
{
    // --merge moves a site into one that already has visits; it may stand anywhere
    $merge = in_array('--merge', $argv, true);
    $args = array_values(array_filter(array_slice($argv, 2), fn ($arg) => $arg !== '--merge'));
    $oldName = $args[0] ?? null;
    $newName = $args[1] ?? null;
    $dbPath = $config['db_path'];
    if (!file_exists($dbPath)) {
        echo "No database found.\n";
        exit(1);
    }

    $db = new PDO('sqlite:' . $dbPath);
    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

    // Interactive site picker if no old name
    if (!$oldName) {
        $availableSites = getTrackedSites($dbPath);
        if (empty($availableSites)) {
            echo "No sites tracked yet.\n";
            exit(1);
        }
        if (count($availableSites) === 1) {
            $oldName = $availableSites[0];
        } else {
            echo "Select site to rename:\n";
            foreach ($availableSites as $i => $s) {
                echo sprintf("  %d) %s\n", $i + 1, $s);
            }
            $idx = (int) prompt("\nSelect (number): ") - 1;
            if ($idx < 0 || $idx >= count($availableSites)) {
                echo "Invalid selection.\n";
                exit(1);
            }
            $oldName = $availableSites[$idx];
        }
    }

    // Interactive prompt for new name
    if (!$newName) {
        $newName = prompt("New name for '{$oldName}': ");
    }
    // As the tracker stores it, so the script's data-site lands on the new name
    $newName = normalizeSiteName($newName);
    if ($newName === '') {
        echo "Name cannot be empty.\n";
        exit(1);
    }

    if ($oldName === $newName) {
        echo "Old and new name are the same.\n";
        exit(1);
    }

    // Check that old site exists
    $stmt = $db->prepare('SELECT COUNT(*) FROM pageviews WHERE site = ?');
    $stmt->execute([$oldName]);
    $count = $stmt->fetchColumn();

    if ($count === 0) {
        echo "Site '{$oldName}' not found in database.\n";
        exit(1);
    }

    // Check that new name doesn't already exist, unless merging into it
    $stmt = $db->prepare('SELECT COUNT(*) FROM pageviews WHERE site = ?');
    $stmt->execute([$newName]);
    $merging = $stmt->fetchColumn() > 0;
    if ($merging && !$merge) {
        echo "Site '{$newName}' already exists. Cannot rename to an existing site.\n";
        echo "  To move '{$oldName}' into it, add --merge: its visits, settings and share links then belong to '{$newName}'.\n";
        exit(1);
    }

    // The site name is part of the visitor hash, so a visitor seen under both names on a day counts twice
    $sharedDays = 0;
    if ($merging) {
        $stmt = $db->prepare('SELECT COUNT(*) FROM (SELECT substr(created_at, 1, 10) FROM pageviews WHERE site = ? INTERSECT SELECT substr(created_at, 1, 10) FROM pageviews WHERE site = ?)');
        $stmt->execute([$oldName, $newName]);
        $sharedDays = (int) $stmt->fetchColumn();
    }

    // Rename in all tables
    $db->beginTransaction();

    $tables = ['pageviews', 'bot_visits', 'broken_links', 'events', 'share_tokens', 'goals', 'app_versions', 'breakdowns', 'annotations', 'excluded_ips', 'site_groups', 'daily', 'bot_days', 'posts'];
    // Skip tables a not-yet-migrated database does not have
    $existing = $db->query("SELECT name FROM sqlite_master WHERE type = 'table'")->fetchAll(PDO::FETCH_COLUMN);
    foreach (array_intersect($tables, $existing) as $table) {
        // The daily summary is a cache: both names' days are summed again, from the merged rows
        if ($merging && $table === 'daily') {
            $db->prepare('DELETE FROM daily WHERE site IN (?, ?)')->execute([$oldName, $newName]);
            continue;
        }
        [$moved, $kept] = moveSiteRows($db, $table, $oldName, $newName);
        $done = [];
        if ($moved > 0) $done[] = "{$moved} rows " . ($merging ? 'moved' : 'updated');
        if ($kept > 0) $done[] = "{$kept} already in '{$newName}', kept as it is";
        if ($done) echo "  {$table}: " . implode(', ', $done) . "\n";
    }

    $db->commit();

    // Update users.json
    $usersFile = $config['users_file'];
    $users = loadUsers($usersFile);
    $usersUpdated = 0;

    foreach ($users as &$user) {
        if (!empty($user['sites']) && in_array($oldName, $user['sites'])) {
            $user['sites'] = array_values(array_unique(array_map(
                fn($s) => $s === $oldName ? $newName : $s,
                $user['sites']
            )));
            $usersUpdated++;
        }
    }
    unset($user);

    if ($usersUpdated > 0) {
        saveUsers($usersFile, $users);
        echo "  users.json: {$usersUpdated} user(s) updated\n";
    }

    if (!$merging) {
        echo "\nRenamed '{$oldName}' → '{$newName}'.\n";
        return;
    }
    if ($sharedDays > 0) {
        $days = $sharedDays === 1 ? '1 day' : "{$sharedDays} days";
        echo "\n{$days} had visits under both names. A visitor seen under both counts twice on those days,\n";
        echo "since the site name is part of the visitor hash.\n";
    }
    echo "\nMerged '{$oldName}' into '{$newName}'. The dashboard sums its days again as it shows them.\n";
}

/**
 * Moves a site's rows in one table to another name, returning [moved, kept]. Into a site with
 * rows of its own (sites:rename --merge) a row can collide with one of theirs: counts are added
 * (bots per day, broken links), a release keeps the day it was first seen, and a setting (a goal,
 * a card, an excluded IP, the group) stays as the other site has it, as does a post it already
 * has. Kept counts those dropped.
 */
function moveSiteRows(PDO $db, string $table, string $old, string $new): array
{
    switch ($table) {
        case 'bot_days':
            $db->prepare('INSERT INTO bot_days (site, date, name, category, visits)
                SELECT ?, date, name, category, visits FROM bot_days WHERE site = ?
                ON CONFLICT (site, date, name, category) DO UPDATE SET visits = visits + excluded.visits')
                ->execute([$new, $old]);
            $moved = $db->prepare('DELETE FROM bot_days WHERE site = ?');
            $moved->execute([$old]);
            return [$moved->rowCount(), 0];

        case 'app_versions':
            $db->prepare('INSERT INTO app_versions (site, version, first_seen)
                SELECT ?, version, first_seen FROM app_versions WHERE site = ?
                ON CONFLICT (site, version) DO UPDATE SET first_seen = MIN(first_seen, excluded.first_seen)')
                ->execute([$new, $old]);
            $moved = $db->prepare('DELETE FROM app_versions WHERE site = ?');
            $moved->execute([$old]);
            return [$moved->rowCount(), 0];

        case 'broken_links':
            // A path broken under both names: hits added, first and last seen widened, referrers joined
            $both = $db->prepare('SELECT o.id AS old_id, n.id AS new_id, o.hits, o.first_seen, o.last_seen, o.referrers, n.referrers AS new_referrers
                FROM broken_links o JOIN broken_links n ON n.site = ? AND n.path = o.path AND n.status = o.status
                WHERE o.site = ?');
            $both->execute([$new, $old]);
            $fold = $db->prepare('UPDATE broken_links SET hits = hits + ?, first_seen = MIN(first_seen, ?), last_seen = MAX(last_seen, ?), referrers = ? WHERE id = ?');
            $drop = $db->prepare('DELETE FROM broken_links WHERE id = ?');
            $folded = 0;
            foreach ($both->fetchAll(PDO::FETCH_ASSOC) as $row) {
                $fold->execute([$row['hits'], $row['first_seen'], $row['last_seen'], joinReferrers($row['new_referrers'], $row['referrers']), $row['new_id']]);
                $drop->execute([$row['old_id']]);
                $folded++;
            }
            $moved = $db->prepare('UPDATE broken_links SET site = ? WHERE site = ?');
            $moved->execute([$new, $old]);
            return [$folded + $moved->rowCount(), 0];

        case 'breakdowns':
            // After the other site's own cards, in their order (position came after the table)
            $columns = array_column($db->query('PRAGMA table_info(breakdowns)')->fetchAll(PDO::FETCH_ASSOC), 'name');
            if (in_array('position', $columns, true)) {
                $after = $db->prepare('SELECT COALESCE(MAX(position), -1) + 1 FROM breakdowns WHERE site = ?');
                $after->execute([$new]);
                $db->prepare('UPDATE breakdowns SET position = position + ? WHERE site = ?')->execute([(int) $after->fetchColumn(), $old]);
            }
            // Then as the other settings
        case 'goals':
        case 'excluded_ips':
        case 'site_groups':
        case 'posts':
            $moved = $db->prepare("UPDATE OR IGNORE {$table} SET site = ? WHERE site = ?");
            $moved->execute([$new, $old]);
            $kept = $db->prepare("DELETE FROM {$table} WHERE site = ?");
            $kept->execute([$old]);
            return [$moved->rowCount(), $kept->rowCount()];

        default:
            $moved = $db->prepare("UPDATE {$table} SET site = ? WHERE site = ?");
            $moved->execute([$new, $old]);
            return [$moved->rowCount(), 0];
    }
}

// Joins two lists of a broken link's referrers as storing a hit does: no repeats, nothing added past 1900 characters
function joinReferrers(?string $into, ?string $from): ?string
{
    foreach (array_filter(explode(',', (string) $from), 'strlen') as $referrer) {
        if ($into === null || $into === '') {
            $into = $referrer;
        } elseif (!in_array($referrer, explode(',', $into), true) && strlen($into) <= 1900) {
            $into .= ',' . $referrer;
        }
    }
    return $into;
}

// =====================================================================
// sites:clean-paths
// =====================================================================

/**
 * Clean a stored path: drop the query string except $keep (when $keep is not
 * null), replace token segments with :token (when $tokens is set) and collapse
 * purely numeric segments to :id (when $ids is set).
 * A token is a whole segment of 16+ letters and digits containing both, or a
 * UUID. Requiring both keeps long words and hyphenated slugs out.
 * Splits on & by hand so parameter names and values stay exactly as stored.
 */
function cleanPath(string $path, ?array $keep, bool $ids, bool $tokens = false): string
{
    [$base, $query] = array_pad(explode('?', $path, 2), 2, null);
    if ($tokens) {
        $base = preg_replace('#/(?:(?=[A-Za-z0-9]*\d)(?=[A-Za-z0-9]*[A-Za-z])[A-Za-z0-9]{16,}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})(?=/|$)#', '/:token', $base);
    }
    if ($ids) {
        $base = preg_replace('#/\d+(?=/|$)#', '/:id', $base);
    }
    if ($query === null) return $base;
    if ($keep === null) return $base . '?' . $query;
    $kept = array_filter(explode('&', $query), function ($pair) use ($keep) {
        $name = urldecode(explode('=', $pair, 2)[0]);
        return $name !== '' && in_array($name, $keep, true);
    });
    return $kept ? $base . '?' . implode('&', $kept) : $base;
}

function sitesCleanPaths(array $config, array $argv): void
{
    $dbPath = $config['db_path'];
    if (!file_exists($dbPath)) {
        echo "No database found.\n";
        exit(1);
    }

    $siteName = null;
    $keep = null;
    $ids = false;
    $tokens = false;
    $dryRun = false;
    foreach (array_slice($argv, 2) as $arg) {
        if ($arg === '--dry-run') {
            $dryRun = true;
        } elseif ($arg === '--query') {
            $keep ??= [];
        } elseif (str_starts_with($arg, '--keep=')) {
            $keep = array_values(array_filter(array_map('trim', explode(',', substr($arg, 7)))));
        } elseif ($arg === '--ids') {
            $ids = true;
        } elseif ($arg === '--tokens') {
            $tokens = true;
        } elseif (!str_starts_with($arg, '--')) {
            $siteName = $arg;
        }
    }

    $db = new PDO('sqlite:' . $dbPath);
    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

    // Interactive site picker and options if no argument; confirm before writing
    $interactive = !$siteName;
    if ($interactive) {
        $availableSites = getTrackedSites($dbPath);
        if (empty($availableSites)) {
            echo "No sites tracked yet.\n";
            exit(1);
        }
        echo "Select site to clean paths for:\n";
        foreach ($availableSites as $i => $s) {
            echo sprintf("  %d) %s\n", $i + 1, $s);
        }
        $idx = (int) prompt("\nSelect (number): ") - 1;
        if ($idx < 0 || $idx >= count($availableSites)) {
            echo "Invalid selection.\n";
            exit(1);
        }
        $siteName = $availableSites[$idx];
        if ($keep === null && strtolower(prompt("Strip query strings? [Y/n]: ")) !== 'n') {
            $keepInput = prompt("Parameters to keep (comma-separated, empty for none): ");
            $keep = array_values(array_filter(array_map('trim', explode(',', $keepInput))));
        }
        if (!$ids) {
            $ids = strtolower(prompt("Collapse numeric segments to :id? [y/N]: ")) === 'y';
        }
        if (!$tokens) {
            $tokens = strtolower(prompt("Replace token segments with :token? [y/N]: ")) === 'y';
        }
    }

    if ($keep === null && !$ids && !$tokens) {
        echo "Nothing selected. Use --query (or --keep=a,b), --ids and/or --tokens.\n";
        exit(1);
    }

    $stmt = $db->prepare('SELECT COUNT(*) FROM pageviews WHERE site = ?');
    $stmt->execute([$siteName]);
    if ((int) $stmt->fetchColumn() === 0) {
        echo "Site '{$siteName}' not found in database.\n";
        exit(1);
    }

    // Table => path column. Skip tables a not-yet-migrated database does not have.
    $columns = ['pageviews' => 'path', 'events' => 'page_path'];
    $existing = $db->query("SELECT name FROM sqlite_master WHERE type = 'table'")->fetchAll(PDO::FETCH_COLUMN);

    $changes = [];
    foreach (array_intersect_key($columns, array_flip($existing)) as $table => $column) {
        $match = [];
        if ($keep !== null) $match[] = "instr({$column}, '?') > 0";
        if ($ids) $match[] = "{$column} GLOB '*/[0-9]*'";
        if ($tokens) $match[] = "length({$column}) > 16";
        $stmt = $db->prepare("SELECT id, {$column} AS path FROM {$table} WHERE site = ? AND (" . implode(' OR ', $match) . ")");
        $stmt->execute([$siteName]);
        foreach ($stmt->fetchAll(PDO::FETCH_ASSOC) as $row) {
            $cleaned = cleanPath($row['path'], $keep, $ids, $tokens);
            if ($cleaned !== $row['path']) {
                $changes[$table][] = [$row['id'], $cleaned];
            }
        }
    }

    $what = [];
    if ($keep !== null) $what[] = 'query strings' . ($keep ? ' (keeping ' . implode(', ', $keep) . ')' : '');
    if ($ids) $what[] = 'numeric ids';
    if ($tokens) $what[] = 'tokens';
    echo "Paths to clean in '{$siteName}', " . implode(', ', $what) . ":\n";
    foreach (array_keys($columns) as $table) {
        $n = count($changes[$table] ?? []);
        echo "  {$table}: {$n} rows\n";
    }

    if (!$changes) {
        echo "\nNothing to clean.\n";
        return;
    }
    if ($dryRun) {
        echo "\nDry run, nothing changed.\n";
        return;
    }
    if ($interactive) {
        $confirm = prompt("\nRewrite these rows? This cannot be undone. [y/N]: ");
        if (strtolower($confirm) !== 'y') {
            echo "Cancelled.\n";
            return;
        }
    }

    $db->beginTransaction();
    foreach ($changes as $table => $rows) {
        $column = $columns[$table];
        $stmt = $db->prepare("UPDATE {$table} SET {$column} = ? WHERE id = ?");
        foreach ($rows as [$id, $path]) {
            $stmt->execute([$path, $id]);
        }
    }
    // The site's daily summary counted the old paths; it is a cache, summed again as needed
    if (isset($changes['pageviews']) && $db->query("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'daily'")->fetchColumn()) {
        $db->prepare('DELETE FROM daily WHERE site = ?')->execute([$siteName]);
    }
    $db->commit();

    echo "\nCleaned paths for '{$siteName}'.\n";
}

