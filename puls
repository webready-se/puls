// share:create
// =====================================================================

function shareCreate(array $config, ?string $site, array $argv): void
{
    $dbPath = $config['db_path'];
    if (!file_exists($dbPath)) {
        echo "No database found. Start tracking to create it.\n";
        exit(1);
    }

    // Interactive site selection if no site argument
    if (!$site || str_starts_with($site, '--')) {
        $availableSites = getTrackedSites($dbPath);
        if (empty($availableSites)) {
            echo "No sites in database yet.\n";
            exit(1);
        }
        if (count($availableSites) === 1) {
            $site = $availableSites[0];
        } else {
            echo "Select site for share link:\n";
            foreach ($availableSites as $i => $s) {
                echo sprintf("  %d) %s\n", $i + 1, $s);
            }
            $idx = (int) prompt("\nSelect (number): ") - 1;
            if ($idx < 0 || $idx >= count($availableSites)) {
                echo "Invalid selection.\n";
                exit(1);
            }
            $site = $availableSites[$idx];
        }
    }

    // Verify site exists
    $db = new PDO('sqlite:' . $dbPath);
    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
    $stmt = $db->prepare('SELECT COUNT(*) FROM pageviews WHERE site = ?');
    $stmt->execute([$site]);
    if ($stmt->fetchColumn() === 0) {
        echo "Site '{$site}' not found in database.\n";
        exit(1);
    }

    // Parse flags (allow both --flag and interactive)
    $label = null;
    $expiresAt = null;
    foreach ($argv as $arg) {
        if (str_starts_with($arg, '--label=')) {
            $label = substr($arg, 8);
        }
        if (str_starts_with($arg, '--expires=')) {
            $date = substr($arg, 10);
            if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $date)) {
                echo "Invalid date format. Use YYYY-MM-DD.\n";
                exit(1);
            }
            $expiresAt = $date . ' 23:59:59';
        }
    }

    // Interactive prompts for missing options
    if ($label === null) {
        $input = prompt("Label (optional, enter to skip): ");
        if ($input !== '') $label = $input;
    }
    if ($expiresAt === null) {
        $input = prompt("Expires (YYYY-MM-DD, enter to skip): ");
        if ($input !== '') {
            if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $input)) {
                echo "Invalid date format. Skipping expiry.\n";
            } else {
                $expiresAt = $input . ' 23:59:59';
            }
        }
    }

    $token = bin2hex(random_bytes(32));
    $stmt = $db->prepare('INSERT INTO share_tokens (token, site, label, expires_at, created_at) VALUES (?, ?, ?, ?, ?)');
    $stmt->execute([$token, $site, $label, $expiresAt, date('Y-m-d H:i:s')]);

    echo "Share link created for '{$site}'.\n";
    if ($label) echo "  Label: {$label}\n";
    if ($expiresAt) echo "  Expires: {$expiresAt}\n";

    $baseUrl = $_ENV['APP_URL'] ?? '';
    if (!$baseUrl) {
        echo "\nAPP_URL not set. Enter your Puls URL to get shareable links\n";
        $url = prompt("(e.g. https://puls.example.com, enter to skip): ");
        if ($url !== '') {
            $baseUrl = rtrim($url, '/');
            $envFile = __DIR__ . '/.env';
            if (file_exists($envFile)) {
                $contents = file_get_contents($envFile);
                $contents = preg_replace('/^APP_URL=.*$/m', "APP_URL={$baseUrl}", $contents);
                file_put_contents($envFile, $contents);
            }
            $_ENV['APP_URL'] = $baseUrl;
        }
    }
    echo "\n  {$baseUrl}/?share={$token}\n\n";
    echo "Share this URL — anyone with the link can view stats for '{$site}'.\n";
}

