// share:list
// =====================================================================

function shareList(array $config, ?string $site): void
{
    $dbPath = $config['db_path'];
    if (!file_exists($dbPath)) {
        echo "No database found.\n";
        exit(1);
    }

    $db = new PDO('sqlite:' . $dbPath);
    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

    // Ensure table exists
    $tables = $db->query("SELECT name FROM sqlite_master WHERE type='table' AND name='share_tokens'")->fetchAll();
    if (empty($tables)) {
        echo "No share tokens found.\n";
        return;
    }

    $sql = 'SELECT * FROM share_tokens';
    $params = [];
    if ($site) {
        $sql .= ' WHERE site = ?';
        $params[] = $site;
    }
    $sql .= ' ORDER BY created_at DESC';

    $stmt = $db->prepare($sql);
    $stmt->execute($params);
    $tokens = $stmt->fetchAll(PDO::FETCH_ASSOC);

    if (empty($tokens)) {
        echo $site ? "No share tokens for '{$site}'.\n" : "No share tokens found.\n";
        return;
    }

    $col = 22;
    echo "  #  " . mbPad('SITE', $col) . sprintf("%-20s %-10s %-12s %s\n", 'LABEL', 'TOKEN', 'EXPIRES', 'CREATED');
    echo str_repeat('─', 90) . "\n";

    foreach ($tokens as $i => $t) {
        $expired = $t['expires_at'] && $t['expires_at'] < date('Y-m-d H:i:s');
        $prefix = substr($t['token'], 0, 8) . '…';
        $expires = $t['expires_at'] ? substr($t['expires_at'], 0, 10) : 'never';
        if ($expired) $expires .= ' ✗';
        $label = $t['label'] ?: '—';
        if (mb_strlen($label) > 18) $label = mb_substr($label, 0, 17) . '…';

        echo sprintf("  %d) ", $i + 1) . mbPad($t['site'], $col) . sprintf("%-20s %-10s %-12s %s\n",
            $label, $prefix, $expires, substr($t['created_at'], 0, 10));
    }

    echo "\n" . count($tokens) . " token(s).\n";

    $input = prompt("\nGet share URL? (number, enter to skip): ");
    if ($input !== '') {
        $idx = (int) $input - 1;
        if ($idx >= 0 && $idx < count($tokens)) {
            $baseUrl = $_ENV['APP_URL'] ?? '';
            echo "\n  {$baseUrl}/?share={$tokens[$idx]['token']}\n\n";
        } else {
            echo "Invalid selection.\n";
        }
    }
}

