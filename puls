#!/usr/bin/env php
<?php
/**
 * Puls CLI
 *
 * Usage:
 *   php puls user:add <name> [--sites=a,b]       Add a user
 *   php puls user:edit [<name>]                   Edit user (sites, password)
 *   php puls user:remove [<name>]                Remove a user
 *   php puls user:list                           List all users
 *   php puls sites:list                          List all tracked sites
 *   php puls sites:rename [<old> <new>]             Rename a site
 *   php puls sites:remove [<name>]                 Delete all data for a site
 *   php puls sites:clean-paths [<site>] [--query|--keep=a,b] [--ids] [--tokens] [--dry-run]  Clean stored paths
 *   php puls share:create <site> [--label=...] [--expires=YYYY-MM-DD]  Create shareable link
 *   php puls share:list [<site>]                  List share tokens
 *   php puls share:revoke [<token>]                Revoke a share token
 *   php puls exclude:add [<site> <ip>] [--label=...]  Stop counting an IP or range (site * = all sites)
 *   php puls exclude:list [<site>]                 List excluded IPs
 *   php puls exclude:remove [<site> <ip>]          Count an excluded IP again
 *   php puls nginx:config                          Generate Nginx config for a site
 */

$config = require __DIR__ . '/config.php';
$command = $argv[1] ?? 'help';

match ($command) {
    'user:add'      => userAdd($config, $argv[2] ?? null, $argv),
    'user:edit'     => userEdit($config, $argv[2] ?? null),
    'user:remove'   => userRemove($config['users_file'], $argv[2] ?? null),
    'user:list'     => userList($config['users_file']),
    'sites:list'    => sitesList($config['db_path']),
    'sites:rename'  => sitesRename($config, $argv[2] ?? null, $argv[3] ?? null),
    'sites:remove'  => sitesRemove($config, $argv[2] ?? null),
    'sites:clean-paths' => sitesCleanPaths($config, $argv),
    'share:create'  => shareCreate($config, $argv[2] ?? null, $argv),
    'share:list'    => shareList($config, $argv[2] ?? null),
    'share:revoke'  => shareRevoke($config, $argv[2] ?? null),
    'exclude:add'   => excludeAdd($config, $argv),
    'exclude:list'  => excludeList($config, $argv[2] ?? null),
    'exclude:remove' => excludeRemove($config, $argv[2] ?? null, $argv[3] ?? null),
    'nginx:config'  => nginxConfig(),
    default         => printHelp(),
};

// =====================================================================
// Helpers
// =====================================================================

function prompt(string $label = ''): string
{
    if (function_exists('readline')) {
        return trim(readline($label));
    }
    if ($label !== '') {
        echo $label;
        flush();
    }
    return trim(fgets(STDIN));
}

/**
 * Read a secret. On a terminal the input is hidden; from a pipe it is one line read through
 * prompt() like every other answer, so piped input stays in order.
 */
function promptSecret(string $label): string
{
    echo $label;
    if (!stream_isatty(STDIN)) {
        $value = prompt();
        echo "\n";
        return $value;
    }
    system('stty -echo');
    $value = trim((string) fgets(STDIN));
    system('stty echo');
    echo "\n";
    return $value;
}

/** A password to read out or type on a phone: four groups of five, no look-alikes (about 99 bits). */
function generatePassword(): string
{
    $alphabet = 'abcdefghjkmnpqrstuvwxyz23456789';
    $groups = [];
    for ($g = 0; $g < 4; $g++) {
        $group = '';
        for ($i = 0; $i < 5; $i++) $group .= $alphabet[random_int(0, strlen($alphabet) - 1)];
        $groups[] = $group;
    }
    return implode('-', $groups);
}

/**
 * Ask for a password, or generate one on Enter. A typed one needs 10 characters and, on a
 * terminal, the same again. Exits with 1 when it is too short or does not match.
 */
function askPassword(string $username): string
{
    $password = promptSecret("Password for {$username} (Enter for a generated one): ");
    if ($password === '') {
        $password = generatePassword();
        echo "Generated password: {$password}\n";
        echo "Copy it now: Puls keeps only a hash of it, so it cannot show it again.\n";
        return $password;
    }
    if (strlen($password) < 10) {
        echo "A password needs at least 10 characters. Press Enter instead for a generated one.\n";
        exit(1);
    }
    if (stream_isatty(STDIN) && promptSecret('Same password again: ') !== $password) {
        echo "The two passwords do not match. Nothing was changed.\n";
        exit(1);
    }
    return $password;
}

// =====================================================================
// user:add
// =====================================================================

function userAdd(array $config, ?string $username, array $argv): void
{
    if (!$username) {
        $username = prompt('Username: ');
        if ($username === '') {
            echo "A username is needed: php puls user:add <username> [--sites=a,b]\n";
            exit(1);
        }
    }

    $users = loadUsers($config['users_file']);

    if (isset($users[$username])) {
        echo "User '{$username}' already exists. Use user:edit to modify.\n";
        exit(1);
    }

    $password = askPassword($username);

    // Parse --sites flag
    $sites = null;
    foreach ($argv as $arg) {
        if (str_starts_with($arg, '--sites=')) {
            $sites = array_values(array_filter(explode(',', substr($arg, 8))));
        }
    }

    // Interactive site selection if --sites not provided
    if ($sites === null) {
        $sites = interactiveSiteSelect($config['db_path'], []);
    }

    $users[$username] = [
        'password' => password_hash($password, PASSWORD_BCRYPT, ['cost' => 12]),
        'sites' => $sites,
    ];

    saveUsers($config['users_file'], $users);
    $scope = $sites ? implode(', ', $sites) : 'all sites';
    $url = rtrim($_ENV['APP_URL'] ?? '', '/');
    echo "Added {$username} (access: {$scope})." . ($url ? " Sign in at {$url}" : '') . "\n";
}

// =====================================================================
// user:edit
// =====================================================================

function userEdit(array $config, ?string $username): void
{
    $users = loadUsers($config['users_file']);

    if (empty($users)) {
        echo "No users configured.\n";
        exit(1);
    }

    // Interactive user picker if no argument
    if (!$username) {
        $names = array_keys($users);
        if (count($names) === 1) {
            $username = $names[0];
        } else {
            echo "Select user to edit:\n";
            foreach ($names as $i => $name) {
                $sites = !empty($users[$name]['sites']) ? implode(', ', $users[$name]['sites']) : 'alla';
                echo sprintf("  %d) %s (%s)\n", $i + 1, $name, $sites);
            }
            $idx = (int) prompt("\nSelect (number): ") - 1;
            if ($idx < 0 || $idx >= count($names)) {
                echo "Invalid selection.\n";
                exit(1);
            }
            $username = $names[$idx];
        }
    }

    if (!isset($users[$username])) {
        echo "User '{$username}' not found.\n";
        exit(1);
    }

    $user = $users[$username];
    $currentSites = $user['sites'] ?? [];
    $scope = $currentSites ? implode(', ', $currentSites) : 'all sites';
    echo "Editing user '{$username}' (current access: {$scope})\n\n";

    // Site selection
    $sites = interactiveSiteSelect($config['db_path'], $currentSites);

    // Password change
    $answer = strtolower(prompt("Change password? (y/N): "));

    if ($answer === 'y' || $answer === 'j') {
        $password = askPassword($username);
        $user['password'] = password_hash($password, PASSWORD_BCRYPT, ['cost' => 12]);
        echo "Password updated.\n";
    }

    $user['sites'] = $sites;
    $users[$username] = $user;

    saveUsers($config['users_file'], $users);
    $scope = $sites ? implode(', ', $sites) : 'all sites';
    echo "User '{$username}' updated (access: {$scope}).\n";
}

// =====================================================================
// user:remove
// =====================================================================

function userRemove(string $file, ?string $username): void
{
    $users = loadUsers($file);

    if (empty($users)) {
        echo "No users configured.\n";
        exit(1);
    }

    // Interactive user picker if no argument
    if (!$username) {
        $names = array_keys($users);
        echo "Select user to remove:\n";
        foreach ($names as $i => $name) {
            $sites = !empty($users[$name]['sites']) ? implode(', ', $users[$name]['sites']) : 'alla';
            echo sprintf("  %d) %s (%s)\n", $i + 1, $name, $sites);
        }
        $idx = (int) prompt("\nSelect (number): ") - 1;
        if ($idx < 0 || $idx >= count($names)) {
            echo "Invalid selection.\n";
            exit(1);
        }
        $username = $names[$idx];
    }

    if (!isset($users[$username])) {
        echo "User '{$username}' not found.\n";
        exit(1);
    }

    $confirm = strtolower(prompt("Remove user '{$username}'? (y/N): "));
    if ($confirm !== 'y' && $confirm !== 'j') {
        echo "Aborted.\n";
        exit(0);
    }

    unset($users[$username]);
    saveUsers($file, $users);
    echo "User '{$username}' removed.\n";
}

// =====================================================================
// user:list
// =====================================================================

function userList(string $file): void
{
    $users = loadUsers($file);

    if (empty($users)) {
        echo "No users configured. Run: php puls user:add <username>\n";
        return;
    }

    echo sprintf("%-20s %s\n", 'USERNAME', 'SITES');
    echo str_repeat('-', 50) . "\n";
    foreach ($users as $name => $data) {
        $sites = !empty($data['sites']) ? implode(', ', $data['sites']) : 'alla';
        echo sprintf("%-20s %s\n", $name, $sites);
    }
}

// =====================================================================
// sites:list
// =====================================================================

function sitesList(string $dbPath): void
{
    if (!file_exists($dbPath)) {
        echo "No database found. Start tracking to create it.\n";
        exit(1);
    }

    $db = new PDO('sqlite:' . $dbPath);
    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

    $stmt = $db->query("
        SELECT
            p.site,
            MIN(p.created_at) as first_seen,
            MAX(p.created_at) as last_seen,
            COUNT(*) as pageviews,
            COUNT(DISTINCT p.visitor_hash) as visitors,
            COALESCE(bl.broken_links, 0) as broken_links
        FROM pageviews p
        LEFT JOIN (
            SELECT site, COUNT(*) as broken_links
            FROM broken_links
            GROUP BY site
        ) bl ON bl.site = p.site
        GROUP BY p.site
        ORDER BY p.site
    ");

    $sites = $stmt->fetchAll(PDO::FETCH_ASSOC);

    if (empty($sites)) {
        echo "No sites tracked yet.\n";
        return;
    }

    $col = 22;
    echo mbPad('SITE', $col) . sprintf("%-12s %-12s %10s %10s %8s\n",
        'SINCE', 'LAST SEEN', 'PAGEVIEWS', 'VISITORS', 'BROKEN');
    echo str_repeat('─', 78) . "\n";

    foreach ($sites as $s) {
        echo mbPad($s['site'], $col) . sprintf("%-12s %-12s %10s %10s %8s\n",
            substr($s['first_seen'], 0, 10),
            substr($s['last_seen'], 0, 10),
            number_format($s['pageviews']),
            number_format($s['visitors']),
            $s['broken_links'] ?: '-'
        );
    }

    echo "\n" . count($sites) . " site(s) tracked.\n";
}

// =====================================================================
// sites:rename
// =====================================================================

function sitesRename(array $config, ?string $oldName, ?string $newName): void
{
    $dbPath = $config['db_path'];
    if (!file_exists($dbPath)) {
        echo "No database found.\n";
        exit(1);
    }

    $db = new PDO('sqlite:' . $dbPath);
    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

    // Interactive site picker if no old name
    if (!$oldName) {
        $availableSites = getTrackedSites($dbPath);
        if (empty($availableSites)) {
            echo "No sites tracked yet.\n";
            exit(1);
        }
        if (count($availableSites) === 1) {
            $oldName = $availableSites[0];
        } else {
            echo "Select site to rename:\n";
            foreach ($availableSites as $i => $s) {
                echo sprintf("  %d) %s\n", $i + 1, $s);
            }
            $idx = (int) prompt("\nSelect (number): ") - 1;
            if ($idx < 0 || $idx >= count($availableSites)) {
                echo "Invalid selection.\n";
                exit(1);
            }
            $oldName = $availableSites[$idx];
        }
    }

    // Interactive prompt for new name
    if (!$newName) {
        $newName = prompt("New name for '{$oldName}': ");
        if ($newName === '') {
            echo "Name cannot be empty.\n";
            exit(1);
        }
    }

    if ($oldName === $newName) {
        echo "Old and new name are the same.\n";
        exit(1);
    }

    // Check that old site exists
    $stmt = $db->prepare('SELECT COUNT(*) FROM pageviews WHERE site = ?');
    $stmt->execute([$oldName]);
    $count = $stmt->fetchColumn();

    if ($count === 0) {
        echo "Site '{$oldName}' not found in database.\n";
        exit(1);
    }

    // Check that new name doesn't already exist
    $stmt = $db->prepare('SELECT COUNT(*) FROM pageviews WHERE site = ?');
    $stmt->execute([$newName]);
    if ($stmt->fetchColumn() > 0) {
        echo "Site '{$newName}' already exists. Cannot rename to an existing site.\n";
        exit(1);
    }

    // Rename in all tables
    $db->beginTransaction();

    $tables = ['pageviews', 'bot_visits', 'broken_links', 'events', 'share_tokens', 'goals', 'app_versions', 'breakdowns', 'annotations', 'excluded_ips'];
    // Skip tables a not-yet-migrated database does not have
    $existing = $db->query("SELECT name FROM sqlite_master WHERE type = 'table'")->fetchAll(PDO::FETCH_COLUMN);
    foreach (array_intersect($tables, $existing) as $table) {
        $stmt = $db->prepare("UPDATE {$table} SET site = ? WHERE site = ?");
        $stmt->execute([$newName, $oldName]);
        $affected = $stmt->rowCount();
        if ($affected > 0) {
            echo "  {$table}: {$affected} rows updated\n";
        }
    }

    $db->commit();

    // Update users.json
    $usersFile = $config['users_file'];
    $users = loadUsers($usersFile);
    $usersUpdated = 0;

    foreach ($users as &$user) {
        if (!empty($user['sites']) && in_array($oldName, $user['sites'])) {
            $user['sites'] = array_values(array_map(
                fn($s) => $s === $oldName ? $newName : $s,
                $user['sites']
            ));
            $usersUpdated++;
        }
    }
    unset($user);

    if ($usersUpdated > 0) {
        saveUsers($usersFile, $users);
        echo "  users.json: {$usersUpdated} user(s) updated\n";
    }

    echo "\nRenamed '{$oldName}' → '{$newName}'.\n";
}

// =====================================================================
// sites:clean-paths
// =====================================================================

/**
 * Clean a stored path: drop the query string except $keep (when $keep is not
 * null), replace token segments with :token (when $tokens is set) and collapse
 * purely numeric segments to :id (when $ids is set).
 * A token is a whole segment of 16+ letters and digits containing both, or a
 * UUID. Requiring both keeps long words and hyphenated slugs out.
 * Splits on & by hand so parameter names and values stay exactly as stored.
 */
function cleanPath(string $path, ?array $keep, bool $ids, bool $tokens = false): string
{
    [$base, $query] = array_pad(explode('?', $path, 2), 2, null);
    if ($tokens) {
        $base = preg_replace('#/(?:(?=[A-Za-z0-9]*\d)(?=[A-Za-z0-9]*[A-Za-z])[A-Za-z0-9]{16,}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})(?=/|$)#', '/:token', $base);
    }
    if ($ids) {
        $base = preg_replace('#/\d+(?=/|$)#', '/:id', $base);
    }
    if ($query === null) return $base;
    if ($keep === null) return $base . '?' . $query;
    $kept = array_filter(explode('&', $query), function ($pair) use ($keep) {
        $name = urldecode(explode('=', $pair, 2)[0]);
        return $name !== '' && in_array($name, $keep, true);
    });
    return $kept ? $base . '?' . implode('&', $kept) : $base;
}

function sitesCleanPaths(array $config, array $argv): void
{
    $dbPath = $config['db_path'];
    if (!file_exists($dbPath)) {
        echo "No database found.\n";
        exit(1);
    }

    $siteName = null;
    $keep = null;
    $ids = false;
    $tokens = false;
    $dryRun = false;
    foreach (array_slice($argv, 2) as $arg) {
        if ($arg === '--dry-run') {
            $dryRun = true;
        } elseif ($arg === '--query') {
            $keep ??= [];
        } elseif (str_starts_with($arg, '--keep=')) {
            $keep = array_values(array_filter(array_map('trim', explode(',', substr($arg, 7)))));
        } elseif ($arg === '--ids') {
            $ids = true;
        } elseif ($arg === '--tokens') {
            $tokens = true;
        } elseif (!str_starts_with($arg, '--')) {
            $siteName = $arg;
        }
    }

    $db = new PDO('sqlite:' . $dbPath);
    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

    // Interactive site picker and options if no argument; confirm before writing
    $interactive = !$siteName;
    if ($interactive) {
        $availableSites = getTrackedSites($dbPath);
        if (empty($availableSites)) {
            echo "No sites tracked yet.\n";
            exit(1);
        }
        echo "Select site to clean paths for:\n";
        foreach ($availableSites as $i => $s) {
            echo sprintf("  %d) %s\n", $i + 1, $s);
        }
        $idx = (int) prompt("\nSelect (number): ") - 1;
        if ($idx < 0 || $idx >= count($availableSites)) {
            echo "Invalid selection.\n";
            exit(1);
        }
        $siteName = $availableSites[$idx];
        if ($keep === null && strtolower(prompt("Strip query strings? [Y/n]: ")) !== 'n') {
            $keepInput = prompt("Parameters to keep (comma-separated, empty for none): ");
            $keep = array_values(array_filter(array_map('trim', explode(',', $keepInput))));
        }
        if (!$ids) {
            $ids = strtolower(prompt("Collapse numeric segments to :id? [y/N]: ")) === 'y';
        }
        if (!$tokens) {
            $tokens = strtolower(prompt("Replace token segments with :token? [y/N]: ")) === 'y';
        }
    }

    if ($keep === null && !$ids && !$tokens) {
        echo "Nothing selected. Use --query (or --keep=a,b), --ids and/or --tokens.\n";
        exit(1);
    }

    $stmt = $db->prepare('SELECT COUNT(*) FROM pageviews WHERE site = ?');
    $stmt->execute([$siteName]);
    if ((int) $stmt->fetchColumn() === 0) {
        echo "Site '{$siteName}' not found in database.\n";
        exit(1);
    }

    // Table => path column. Skip tables a not-yet-migrated database does not have.
    $columns = ['pageviews' => 'path', 'events' => 'page_path'];
    $existing = $db->query("SELECT name FROM sqlite_master WHERE type = 'table'")->fetchAll(PDO::FETCH_COLUMN);

    $changes = [];
    foreach (array_intersect_key($columns, array_flip($existing)) as $table => $column) {
        $match = [];
        if ($keep !== null) $match[] = "instr({$column}, '?') > 0";
        if ($ids) $match[] = "{$column} GLOB '*/[0-9]*'";
        if ($tokens) $match[] = "length({$column}) > 16";
        $stmt = $db->prepare("SELECT id, {$column} AS path FROM {$table} WHERE site = ? AND (" . implode(' OR ', $match) . ")");
        $stmt->execute([$siteName]);
        foreach ($stmt->fetchAll(PDO::FETCH_ASSOC) as $row) {
            $cleaned = cleanPath($row['path'], $keep, $ids, $tokens);
            if ($cleaned !== $row['path']) {
                $changes[$table][] = [$row['id'], $cleaned];
            }
        }
    }

    $what = [];
    if ($keep !== null) $what[] = 'query strings' . ($keep ? ' (keeping ' . implode(', ', $keep) . ')' : '');
    if ($ids) $what[] = 'numeric ids';
    if ($tokens) $what[] = 'tokens';
    echo "Paths to clean in '{$siteName}', " . implode(', ', $what) . ":\n";
    foreach (array_keys($columns) as $table) {
        $n = count($changes[$table] ?? []);
        echo "  {$table}: {$n} rows\n";
    }

    if (!$changes) {
        echo "\nNothing to clean.\n";
        return;
    }
    if ($dryRun) {
        echo "\nDry run, nothing changed.\n";
        return;
    }
    if ($interactive) {
        $confirm = prompt("\nRewrite these rows? This cannot be undone. [y/N]: ");
        if (strtolower($confirm) !== 'y') {
            echo "Cancelled.\n";
            return;
        }
    }

    $db->beginTransaction();
    foreach ($changes as $table => $rows) {
        $column = $columns[$table];
        $stmt = $db->prepare("UPDATE {$table} SET {$column} = ? WHERE id = ?");
        foreach ($rows as [$id, $path]) {
            $stmt->execute([$path, $id]);
        }
    }
    $db->commit();

    echo "\nCleaned paths for '{$siteName}'.\n";
}

// =====================================================================
// sites:remove
// =====================================================================

function sitesRemove(array $config, ?string $siteName): void
{
    $dbPath = $config['db_path'];
    if (!file_exists($dbPath)) {
        echo "No database found.\n";
        exit(1);
    }

    $db = new PDO('sqlite:' . $dbPath);
    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

    // Interactive site picker if no argument
    if (!$siteName) {
        $availableSites = getTrackedSites($dbPath);
        if (empty($availableSites)) {
            echo "No sites tracked yet.\n";
            exit(1);
        }
        echo "Select site to remove:\n";
        foreach ($availableSites as $i => $s) {
            echo sprintf("  %d) %s\n", $i + 1, $s);
        }
        $idx = (int) prompt("\nSelect (number): ") - 1;
        if ($idx < 0 || $idx >= count($availableSites)) {
            echo "Invalid selection.\n";
            exit(1);
        }
        $siteName = $availableSites[$idx];
    }

    // Check that site exists
    $stmt = $db->prepare('SELECT COUNT(*) FROM pageviews WHERE site = ?');
    $stmt->execute([$siteName]);
    $pvCount = (int) $stmt->fetchColumn();

    $stmt = $db->prepare('SELECT COUNT(*) FROM bot_visits WHERE site = ?');
    $stmt->execute([$siteName]);
    $botCount = (int) $stmt->fetchColumn();

    $stmt = $db->prepare('SELECT COUNT(*) FROM broken_links WHERE site = ?');
    $stmt->execute([$siteName]);
    $blCount = (int) $stmt->fetchColumn();

    $stmt = $db->prepare('SELECT COUNT(*) FROM events WHERE site = ?');
    $stmt->execute([$siteName]);
    $evCount = (int) $stmt->fetchColumn();

    $total = $pvCount + $botCount + $blCount + $evCount;

    if ($total === 0) {
        echo "Site '{$siteName}' not found in database.\n";
        exit(1);
    }

    echo "This will permanently delete ALL data for '{$siteName}':\n";
    echo "  Pageviews:    {$pvCount}\n";
    echo "  Bot visits:   {$botCount}\n";
    echo "  Broken links: {$blCount}\n";
    echo "  Events:       {$evCount}\n";
    $confirm = prompt("\nType the site name to confirm: ");

    if ($confirm !== $siteName) {
        echo "Aborted.\n";
        exit(1);
    }

    $db->beginTransaction();
    $tables = ['pageviews', 'bot_visits', 'broken_links', 'events', 'share_tokens', 'goals', 'app_versions', 'breakdowns', 'annotations', 'excluded_ips'];
    // Skip tables a not-yet-migrated database does not have
    $existing = $db->query("SELECT name FROM sqlite_master WHERE type = 'table'")->fetchAll(PDO::FETCH_COLUMN);
    foreach (array_intersect($tables, $existing) as $table) {
        $stmt = $db->prepare("DELETE FROM {$table} WHERE site = ?");
        $stmt->execute([$siteName]);
        $affected = $stmt->rowCount();
        if ($affected > 0) {
            echo "  {$table}: {$affected} rows deleted\n";
        }
    }
    $db->commit();

    // Clean up user site restrictions
    $users = loadUsers($config['users_file']);
    foreach ($users as &$user) {
        if (!empty($user['sites']) && in_array($siteName, $user['sites'])) {
            $user['sites'] = array_values(array_filter($user['sites'], fn($s) => $s !== $siteName));
        }
    }
    unset($user);
    saveUsers($config['users_file'], $users);

    echo "\nSite '{$siteName}' removed.\n";
}

