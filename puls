// stats:build
// =====================================================================

/**
 * Sums every finished day of every site into the daily summary, so the dashboard reads long
 * periods from it from the first view. Without it the dashboard sums the days it meets, a few
 * per view, and the daily job sums each day as it ends; this is for an upgraded install that
 * wants it done at once. The summing is the dashboard's own, read from public/index.php
 */
function statsBuild(string $dbPath): void
{
    if (!file_exists($dbPath)) {
        echo "No database found. Start tracking to create it.\n";
        exit(1);
    }
    $source = file_get_contents(__DIR__ . '/public/index.php');
    foreach (['create_daily_table', 'channel_sql', 'range_rows', 'store_days', 'last_closed_day', 'sum_missing_days'] as $name) {
        if (function_exists($name)) continue;
        if (!preg_match('/^function ' . $name . '\([^)]*\)(?:: [^\n]+)?\n\{.+?\n\}/ms', $source, $m)) {
            echo "Could not read {$name}() from public/index.php.\n";
            exit(1);
        }
        eval($m[0]);
    }

    $db = new PDO('sqlite:' . $dbPath);
    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
    // Tracking goes on writing meanwhile: wait for it rather than fail; each day is a short write
    $db->exec('PRAGMA busy_timeout = 10000');
    create_daily_table($db);

    $sites = $db->query('SELECT DISTINCT site FROM pageviews ORDER BY site')->fetchAll(PDO::FETCH_COLUMN);
    $count = $db->prepare("SELECT COUNT(*) FROM daily WHERE site = ? AND kind = 'day'");
    $total = 0;
    foreach ($sites as $site) {
        $count->execute([$site]);
        $before = (int) $count->fetchColumn();
        // An open statement keeps its read going, and SQLite then refuses the write at once when
        // tracking has written meanwhile, instead of waiting (SQLITE_BUSY_SNAPSHOT)
        $count->closeCursor();
        sum_missing_days($db, [$site], '0000-00-00', '', PHP_INT_MAX);
        $count->execute([$site]);
        $summed = (int) $count->fetchColumn() - $before;
        $count->closeCursor();
        $total += $summed;
        echo "  {$site}: " . ($summed ? "{$summed} days summed" : 'up to date') . "\n";
    }
    echo "\n" . ($total ? "Summed {$total} days." : 'Every finished day was summed already.') . " The dashboard reads them from the summary; today is always read from the pageviews.\n";
}

// =====================================================================
// sites:group, sites:ungroup
// =====================================================================

/** Open the database with the site_groups table in place, for a database the web app has not migrated yet. */
function siteGroupsDb(string $dbPath): PDO
{
    if (!file_exists($dbPath)) {
        echo "No database found. Start tracking to create it.\n";
        exit(1);
    }
    $db = new PDO('sqlite:' . $dbPath);
    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
    // Same schema as migration v27
    $db->exec('CREATE TABLE IF NOT EXISTS site_groups (
        site TEXT PRIMARY KEY,
        group_name TEXT NOT NULL
    )');
    return $db;
}

/** Every site that is in a group, as site => group name. Empty when the table is not there yet. */
function siteGroupMap(PDO $db): array
{
    $map = [];
    $exists = $db->query("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'site_groups'")->fetchColumn();
    if (!$exists) return $map;
    foreach ($db->query('SELECT site, group_name FROM site_groups ORDER BY group_name, site') as $row) {
        $map[$row['site']] = $row['group_name'];
    }
    return $map;
}

/** A group name as stored: trimmed, at most 100 characters, without the characters a site name may not hold. Null when empty. */
function normalizeGroupName(string $name): ?string
{
    $name = trim(preg_replace('/[<>"\'`\\\\\x00-\x1f\x7f]/', '', $name));
    $name = mb_substr($name, 0, 100);
    return $name === '' ? null : $name;
}

/**
 * Pick sites by number from a numbered list already printed: "1,3", "1 3", or "all".
 * Returns the picked names, or null when the answer names nothing.
 */
function pickSites(array $available): ?array
{
    $answer = strtolower(trim(prompt("\nSelect (numbers, comma-separated, or all): ")));
    if ($answer === 'all') return $available;
    $picked = [];
    foreach (preg_split('/[\s,]+/', $answer, -1, PREG_SPLIT_NO_EMPTY) as $n) {
        $idx = (int) $n - 1;
        if (!ctype_digit($n) || $idx < 0 || $idx >= count($available)) {
            echo "Invalid selection: {$n}.\n";
            exit(1);
        }
        $picked[$available[$idx]] = true;
    }
    return $picked ? array_keys($picked) : null;
}

function sitesGroup(array $config, array $argv): void
{
    $db = siteGroupsDb($config['db_path']);
    $groupArg = $argv[2] ?? null;
    $siteArgs = array_slice($argv, 3);
    $tracked = getTrackedSites($config['db_path']);
    $groups = siteGroupMap($db);

    if ($groupArg === null) {
        if (empty($tracked)) {
            echo "No sites tracked yet.\n";
            exit(1);
        }
        $names = array_values(array_unique(array_values($groups)));
        sort($names, SORT_NATURAL | SORT_FLAG_CASE);
        if ($names) {
            echo "Groups:\n";
            foreach ($names as $i => $g) {
                $count = count(array_keys($groups, $g, true));
                echo sprintf("  %d) %s (%d site%s)\n", $i + 1, $g, $count, $count === 1 ? '' : 's');
            }
            $answer = trim(prompt("\nSelect a group (number) or type a new name: "));
            $groupArg = ctype_digit($answer) && isset($names[(int) $answer - 1]) ? $names[(int) $answer - 1] : $answer;
        } else {
            $groupArg = prompt("Group name (e.g. Shops): ");
        }
    }
    $group = normalizeGroupName($groupArg);
    if ($group === null) {
        echo "Group name cannot be empty.\n";
        exit(1);
    }

    if (empty($siteArgs)) {
        if (empty($tracked)) {
            echo "No sites tracked yet.\n";
            exit(1);
        }
        echo "\nSites to put in '{$group}':\n";
        foreach ($tracked as $i => $s) {
            $in = isset($groups[$s]) ? "  ({$groups[$s]})" : '';
            echo sprintf("  %d) %s%s\n", $i + 1, $s, $in);
        }
        $siteArgs = pickSites($tracked);
        if ($siteArgs === null) {
            echo "No sites selected.\n";
            exit(1);
        }
    }

    $unknown = array_values(array_diff($siteArgs, $tracked));
    if ($unknown) {
        echo "Not a tracked site: " . implode(', ', $unknown) . ".\n";
        echo "Run `php puls sites:list` to see the names.\n";
        exit(1);
    }

    $stmt = $db->prepare('INSERT OR REPLACE INTO site_groups (site, group_name) VALUES (?, ?)');
    $db->beginTransaction();
    foreach (array_unique($siteArgs) as $s) {
        $stmt->execute([$s, $group]);
        $from = isset($groups[$s]) && $groups[$s] !== $group ? " (was in '{$groups[$s]}')" : '';
        echo "  {$s} → {$group}{$from}\n";
    }
    $db->commit();
    $total = count(array_keys(siteGroupMap($db), $group, true));
    echo "\n{$total} site" . ($total === 1 ? '' : 's') . " in '{$group}'.\n";
    $left = array_values(array_unique(array_diff(array_map(fn ($s) => $groups[$s] ?? '', array_unique($siteArgs)), ['', $group])));
    sayWhoReads($db, [$group], $left);
}

// A token for a group follows its sites, so moving one changes what a token's holder can read
function sayWhoReads(PDO $db, array $movedInto, array $movedOutOf): void
{
    $db = shareTokensDb($db->query('PRAGMA database_list')->fetch(PDO::FETCH_ASSOC)['file']);
    foreach ($db->query('SELECT * FROM share_tokens')->fetchAll(PDO::FETCH_ASSOC) as $t) {
        $groups = shareTokenGroups($t);
        $name = $t['label'] ?: shareTokenStart($t) . '…';
        if (array_intersect($movedInto, $groups)) echo "The token '{$name}' reads these sites now.\n";
        elseif (array_intersect($movedOutOf, $groups)) echo "The token '{$name}' no longer reads these sites.\n";
    }
}

function sitesUngroup(array $config, array $argv): void
{
    $db = siteGroupsDb($config['db_path']);
    $siteArgs = array_slice($argv, 2);
    $groups = siteGroupMap($db);

    if (empty($siteArgs)) {
        if (empty($groups)) {
            echo "No site is in a group.\n";
            exit(1);
        }
        $grouped = array_keys($groups);
        echo "Sites in a group:\n";
        foreach ($grouped as $i => $s) {
            echo sprintf("  %d) %s  (%s)\n", $i + 1, $s, $groups[$s]);
        }
        $siteArgs = pickSites($grouped);
        if ($siteArgs === null) {
            echo "No sites selected.\n";
            exit(1);
        }
    }

    $stmt = $db->prepare('DELETE FROM site_groups WHERE site = ?');
    $db->beginTransaction();
    foreach (array_unique($siteArgs) as $s) {
        if (!isset($groups[$s])) {
            echo "  {$s}: not in a group\n";
            continue;
        }
        $stmt->execute([$s]);
        echo "  {$s}: no longer in '{$groups[$s]}'\n";
    }
    $db->commit();
    sayWhoReads($db, [], array_values(array_unique(array_filter(array_map(fn ($s) => $groups[$s] ?? '', array_unique($siteArgs))))));
}

// =====================================================================
// sites:remove
// =====================================================================

function sitesRemove(array $config, ?string $siteName): void
{
    $dbPath = $config['db_path'];
    if (!file_exists($dbPath)) {
        echo "No database found.\n";
        exit(1);
    }

    $db = new PDO('sqlite:' . $dbPath);
    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

    // Interactive site picker if no argument
    if (!$siteName) {
        $availableSites = getTrackedSites($dbPath);
        if (empty($availableSites)) {
            echo "No sites tracked yet.\n";
            exit(1);
        }
        echo "Select site to remove:\n";
        foreach ($availableSites as $i => $s) {
            echo sprintf("  %d) %s\n", $i + 1, $s);
        }
        $idx = (int) prompt("\nSelect (number): ") - 1;
        if ($idx < 0 || $idx >= count($availableSites)) {
            echo "Invalid selection.\n";
            exit(1);
        }
        $siteName = $availableSites[$idx];
    }

    // Check that site exists
    $stmt = $db->prepare('SELECT COUNT(*) FROM pageviews WHERE site = ?');
    $stmt->execute([$siteName]);
    $pvCount = (int) $stmt->fetchColumn();

    $stmt = $db->prepare('SELECT COUNT(*) FROM bot_visits WHERE site = ?');
    $stmt->execute([$siteName]);
    $botCount = (int) $stmt->fetchColumn();

    $stmt = $db->prepare('SELECT COUNT(*) FROM broken_links WHERE site = ?');
    $stmt->execute([$siteName]);
    $blCount = (int) $stmt->fetchColumn();

    $stmt = $db->prepare('SELECT COUNT(*) FROM events WHERE site = ?');
    $stmt->execute([$siteName]);
    $evCount = (int) $stmt->fetchColumn();

    $total = $pvCount + $botCount + $blCount + $evCount;

    if ($total === 0) {
        echo "Site '{$siteName}' not found in database.\n";
        exit(1);
    }

    echo "This will permanently delete ALL data for '{$siteName}':\n";
    echo "  Pageviews:    {$pvCount}\n";
    echo "  Bot visits:   {$botCount}\n";
    echo "  Broken links: {$blCount}\n";
    echo "  Events:       {$evCount}\n";
    $confirm = prompt("\nType the site name to confirm: ");

    if ($confirm !== $siteName) {
        echo "Aborted.\n";
        exit(1);
    }

    $db->beginTransaction();
    $tables = ['pageviews', 'bot_visits', 'broken_links', 'events', 'share_tokens', 'goals', 'app_versions', 'breakdowns', 'annotations', 'excluded_ips', 'site_groups', 'daily', 'bot_days'];
    // Skip tables a not-yet-migrated database does not have
    $existing = $db->query("SELECT name FROM sqlite_master WHERE type = 'table'")->fetchAll(PDO::FETCH_COLUMN);
    foreach (array_intersect($tables, $existing) as $table) {
        $stmt = $db->prepare("DELETE FROM {$table} WHERE site = ?");
        $stmt->execute([$siteName]);
        $affected = $stmt->rowCount();
        if ($affected > 0) {
            echo "  {$table}: {$affected} rows deleted\n";
        }
    }
    $db->commit();

    // Clean up user site restrictions
    $users = loadUsers($config['users_file']);
    foreach ($users as &$user) {
        if (!empty($user['sites']) && in_array($siteName, $user['sites'])) {
            $user['sites'] = array_values(array_filter($user['sites'], fn($s) => $s !== $siteName));
        }
    }
    unset($user);
    saveUsers($config['users_file'], $users);

    echo "\nSite '{$siteName}' removed.\n";
}

// =====================================================================
// share:create
// =====================================================================

// The database with what tokens need. Same columns as migration v31: the CLI does not run migrations
function shareTokensDb(string $dbPath): PDO
{
    $db = siteGroupsDb($dbPath);
    $db->exec('CREATE TABLE IF NOT EXISTS share_tokens (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        token TEXT NOT NULL UNIQUE,
        site TEXT NOT NULL,
        label TEXT,
        expires_at TEXT,
        created_at TEXT NOT NULL
    )');
    $columns = array_column($db->query('PRAGMA table_info(share_tokens)')->fetchAll(PDO::FETCH_ASSOC), 'name');
    if (!in_array('group_names', $columns, true)) $db->exec('ALTER TABLE share_tokens ADD COLUMN group_names TEXT');
    if (!in_array('last_used_at', $columns, true)) $db->exec('ALTER TABLE share_tokens ADD COLUMN last_used_at TEXT');
    return $db;
}

function shareTokenGroups(array $token): array
{
    return json_decode($token['group_names'] ?? '', true) ?: [];
}

// What a token reads, in words: its site, or its groups with how many sites they hold now
function shareReads(array $token, array $groupMap): string
{
    $groups = shareTokenGroups($token);
    if (!$groups) return $token['site'];
    $count = count(array_intersect($groupMap, $groups));
    $sites = $count === 0 ? 'no sites, reads nothing' : ($count === 1 ? '1 site' : "{$count} sites");
    return implode(', ', $groups) . " ({$sites})";
}

function shareTokenStart(array $token): string
{
    return substr($token['token'], 0, str_starts_with($token['token'], 'puls_') ? 13 : 8);
}

// A last day as stored, or null for never. Stops on anything else
function shareExpiry(string $value): ?string
{
    if ($value === 'never') return null;
    if (!preg_match('/^(\d{4})-(\d{2})-(\d{2})$/', $value, $m) || !checkdate((int) $m[2], (int) $m[3], (int) $m[1])) {
        echo "Invalid date. Use YYYY-MM-DD, or never.\n";
        exit(1);
    }
    return $value . ' 23:59:59';
}

function shareExpiryWords(?string $expiresAt): string
{
    return $expiresAt ? 'Works until ' . date('j M Y', strtotime($expiresAt)) . '.' : 'Works until it is revoked.';
}

// Numbers from a list: one, several (1,4) or a range (1-3)
function parseNumberList(string $answer, int $max): array
{
    $picked = [];
    foreach (preg_split('/[\s,]+/', trim($answer), -1, PREG_SPLIT_NO_EMPTY) as $part) {
        if (!preg_match('/^(\d+)(?:-(\d+))?$/', $part, $m)) {
            echo "Invalid selection: {$part}.\n";
            exit(1);
        }
        foreach (range((int) $m[1], (int) ($m[2] ?? $m[1])) as $n) {
            if ($n < 1 || $n > $max) {
                echo "Invalid selection: {$n}.\n";
                exit(1);
            }
            $picked[$n] = true;
        }
    }
    return array_keys($picked);
}

// Group names from a flag's value, stopping on one that holds no sites
function shareGroupsFrom(string $value, array $groupMap): array
{
    $groups = array_values(array_unique(array_filter(array_map('trim', explode(',', $value)), fn ($g) => $g !== '')));
    $unknown = array_values(array_diff($groups, array_values($groupMap)));
    if (!$groups || $unknown) {
        echo $unknown ? 'No such group: ' . implode(', ', $unknown) . ".\n" : "Name at least one group.\n";
        echo "Run `php puls sites:list` to see the groups.\n";
        exit(1);
    }
    return $groups;
}

function shareCreate(array $config, ?string $name, array $argv): void
{
    $dbPath = $config['db_path'];
    if (!file_exists($dbPath)) {
        echo "No database found. Start tracking to create it.\n";
        exit(1);
    }
    $db = shareTokensDb($dbPath);
    $tracked = getTrackedSites($dbPath);
    $groupMap = siteGroupMap($db);

    $flags = shareFlags($argv);
    if ($name !== null && str_starts_with($name, '--')) $name = null;

    $site = '';
    $groups = [];
    if (isset($flags['groups'])) {
        $groups = shareGroupsFrom($flags['groups'], $groupMap);
    } elseif ($name !== null) {
        // A site first when a group has the same name: it reads less, and --groups= means the group
        if (in_array($name, $tracked, true)) $site = $name;
        elseif (in_array($name, $groupMap, true)) $groups = [$name];
        else {
            echo "'{$name}' is neither a tracked site nor a group.\n";
            exit(1);
        }
    } else {
        [$site, $groups] = pickShareTarget($tracked, $groupMap);
    }

    $label = $flags['label'] ?? null;
    if ($label === null) {
        $input = prompt("Label (who reads it, optional, enter to skip): ");
        if ($input !== '') $label = $input;
    }

    // 90 days unless told otherwise: a forgotten token stops by itself. Never has to be chosen
    if (isset($flags['expires'])) {
        $expiresAt = shareExpiry($flags['expires']);
    } else {
        $default = date('Y-m-d', strtotime('+90 days'));
        $input = prompt("Last day (YYYY-MM-DD, or never) [{$default}]: ");
        $expiresAt = shareExpiry($input !== '' ? $input : $default);
    }

    $token = 'puls_' . bin2hex(random_bytes(20));
    $stmt = $db->prepare('INSERT INTO share_tokens (token, site, group_names, label, expires_at, created_at) VALUES (?, ?, ?, ?, ?, ?)');
    $stmt->execute([$token, $site, $groups ? json_encode($groups, JSON_UNESCAPED_UNICODE) : null, $label, $expiresAt, date('Y-m-d H:i:s')]);
    $row = ['token' => $token, 'site' => $site, 'group_names' => $groups ? json_encode($groups) : null];

    $baseUrl = $_ENV['APP_URL'] ?? '';
    if (!$baseUrl) {
        echo "\nAPP_URL not set. Enter your Puls URL to get the lines below filled in\n";
        $url = prompt("(e.g. https://puls.example.com, enter to skip): ");
        if ($url !== '') {
            $baseUrl = rtrim($url, '/');
            $envFile = __DIR__ . '/.env';
            if (file_exists($envFile)) {
                $contents = file_get_contents($envFile);
                $contents = preg_replace('/^APP_URL=.*$/m', "APP_URL={$baseUrl}", $contents);
                file_put_contents($envFile, $contents);
            }
            $_ENV['APP_URL'] = $baseUrl;
        }
    }
    $shownUrl = $baseUrl ?: 'https://your-puls-domain';
    $start = shareTokenStart($row);

    echo "\nToken created. It reads " . shareReads($row, $groupMap) . ".\n";
    if ($label) echo "  Label: {$label}\n";
    echo '  ' . shareExpiryWords($expiresAt) . "\n";
    echo "\nPut these lines in the .env of the project that reads it:\n\n";
    echo "  PULS_URL={$shownUrl}\n  PULS_SHARE_TOKEN={$token}\n";
    echo "\nCheck that git ignores that file (this prints .env when it does):\n\n  git check-ignore .env\n";
    echo "\nNever give them a PUBLIC_, VITE_ or NEXT_PUBLIC_ prefix: frameworks send those to the browser.\n";
    echo "\nRead the data with a command that loads .env itself, so the token never shows in a command, a log or an AI assistant's session:\n\n";
    echo "  (set -a; . ./.env; curl -s -H \"Authorization: Bearer \$PULS_SHARE_TOKEN\" \"\$PULS_URL/?api&days=30&format=md\")\n";
    if ($groups) echo "\nThat covers its sites together, with a line per site. For one of them, add &site=<name> to the address, as /?api&sites lists the names.\n";
    echo "\nExtend it or end it:\n\n  php puls share:edit {$start} --expires=YYYY-MM-DD\n  php puls share:revoke {$start}\n";
    echo "\nThe token also opens a read-only dashboard, to send to a person:\n\n  {$shownUrl}/?share={$token}\n";
}

function shareFlags(array $argv): array
{
    $flags = [];
    foreach ($argv as $arg) {
        foreach (['label', 'expires', 'groups'] as $flag) {
            if (str_starts_with($arg, "--{$flag}=")) $flags[$flag] = substr($arg, strlen($flag) + 3);
        }
    }
    return $flags;
}

// Asked with nothing: groups first, since one token per reader usually means a group. [site, groups]
function pickShareTarget(array $tracked, array $groupMap): array
{
    $names = array_values(array_unique(array_values($groupMap)));
    sort($names, SORT_NATURAL | SORT_FLAG_CASE);
    if (empty($tracked) && empty($names)) {
        echo "No sites in database yet.\n";
        exit(1);
    }
    if (!$names && count($tracked) === 1) return [$tracked[0], []];

    echo "What should the token read? One site, or one or more groups:\n";
    $n = 0;
    foreach ($names as $g) {
        $count = count(array_keys($groupMap, $g, true));
        echo sprintf("  %d) %s (%d site%s)\n", ++$n, $g, $count, $count === 1 ? '' : 's');
    }
    foreach ($tracked as $s) echo sprintf("  %d) %s\n", ++$n, $s);

    $answer = prompt($names ? "\nSelect (a number or a name, or groups as 1,2 or 1-2, 0 for all groups): " : "\nSelect (a number or a name): ");
    // By what people call it, a site first, as when it is given as an argument
    if (in_array($answer, $tracked, true)) return [$answer, []];
    if (in_array($answer, $names, true)) return ['', [$answer]];
    if ($answer === '0' && $names) return ['', $names];
    if ($answer !== '' && !preg_match('/^[\d\s,-]+$/', $answer)) {
        echo "'{$answer}' is neither a tracked site nor a group.\n";
        exit(1);
    }
    $picked = parseNumberList($answer, $n);
    $pickedGroups = array_values(array_filter($picked, fn ($i) => $i <= count($names)));
    $pickedSites = array_values(array_filter($picked, fn ($i) => $i > count($names)));
    if (!$picked || ($pickedSites && ($pickedGroups || count($pickedSites) > 1))) {
        echo "A token reads one site or some groups: put several sites in a group, and the token follows them.\n";
        exit(1);
    }
    if ($pickedSites) return [$tracked[$pickedSites[0] - count($names) - 1], []];
    return ['', array_map(fn ($i) => $names[$i - 1], $pickedGroups)];
}

// A token by the start of it, or from a list when asked with nothing
function pickShareToken(PDO $db, ?string $start, string $verb): array
{
    if ($start === null || str_starts_with($start, '--')) {
        $all = $db->query('SELECT * FROM share_tokens ORDER BY created_at DESC')->fetchAll(PDO::FETCH_ASSOC);
        if (empty($all)) {
            echo "No share tokens found.\n";
            exit(1);
        }
        echo "Select token to {$verb}:\n\n";
        printShareTokens($all, siteGroupMap($db));
        $idx = (int) prompt("\nSelect (number): ") - 1;
        if ($idx < 0 || $idx >= count($all)) {
            echo "Invalid selection.\n";
            exit(1);
        }
        return $all[$idx];
    }

    $stmt = $db->prepare("SELECT * FROM share_tokens WHERE token LIKE ? ESCAPE '\\'");
    $stmt->execute([addcslashes($start, '%_\\') . '%']);
    $matches = $stmt->fetchAll(PDO::FETCH_ASSOC);
    if (empty($matches)) {
        echo "No token matching '{$start}'.\n";
        exit(1);
    }
    if (count($matches) > 1) {
        echo "Multiple tokens match '{$start}':\n";
        foreach ($matches as $t) {
            echo "  " . substr($t['token'], 0, 16) . "…  (" . ($t['site'] ?: implode(', ', shareTokenGroups($t))) . ($t['label'] ? ", {$t['label']}" : '') . ")\n";
        }
        echo "Provide a longer prefix to uniquely identify the token.\n";
        exit(1);
    }
    return $matches[0];
}

function printShareTokens(array $tokens, array $groupMap): void
{
    $col = max(array_merge([5], array_map(fn ($t) => mb_strlen(shareReads($t, $groupMap)), $tokens))) + 2;
    echo "  #  " . mbPad('READS', $col) . mbPad('LABEL', 21) . mbPad('TOKEN', 16) . mbPad('EXPIRES', 13) . "LAST USED\n";
    echo str_repeat('─', $col + 70) . "\n";
    foreach ($tokens as $i => $t) {
        $expired = $t['expires_at'] && $t['expires_at'] < date('Y-m-d H:i:s');
        $expires = $t['expires_at'] ? substr($t['expires_at'], 0, 10) : 'never';
        if ($expired) $expires .= ' ✗';
        $label = $t['label'] ?: '–';
        if (mb_strlen($label) > 18) $label = mb_substr($label, 0, 17) . '…';
        echo sprintf("  %d) ", $i + 1) . mbPad(shareReads($t, $groupMap), $col) . mbPad($label, 21) . mbPad(shareTokenStart($t) . '…', 16) . mbPad($expires, 13)
            . (!empty($t['last_used_at']) ? substr($t['last_used_at'], 0, 10) : '–') . "\n";
    }
}

