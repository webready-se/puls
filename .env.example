# Base URL for this Puls instance (used in CLI output, e.g. share links).
# Example: https://puls.example.com
APP_URL=

# Allowed origins for tracking (comma-separated domains).
# Empty = allow all (fine for same-domain tracking).
# Subdomains are included automatically (webready.se also allows www.webready.se, app.webready.se, etc.)
# Example: webready.se,example.com
ALLOWED_ORIGINS=

# Database path (relative to project root)
DB_PATH=data/puls.sqlite

# Users file path (relative to project root)
USERS_FILE=users.json

# Session lifetime in seconds (default: 30 days)
SESSION_LIFETIME=2592000

# Brute-force protection: failed logins per IP address within LOCKOUT_MINUTES
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Bot UA patterns to exclude from bot_visits (comma-separated, case-insensitive substring match).
# Example: IGNORED_BOTS=Go-http-client,UptimeRobot
IGNORED_BOTS=

# Reverse proxies in front of Puls (comma-separated IPs or CIDR ranges), e.g. a
# Docker network, a load balancer or Cloudflare. Only requests from these may set
# the visitor IP via X-Forwarded-For / X-Real-IP. Leave empty when visitors
# connect to Puls directly (Nginx + PHP-FPM, Forge). Example: 172.16.0.0/12
TRUSTED_PROXIES=

# Days to keep custom events (default 400, a full year for year-over-year).
# 0 keeps events forever. Events are small: about 300 bytes each with indexes.
EVENTS_RETENTION_DAYS=400

# Time zone for stored times and for days and hours in the dashboard, as a tz database name.
# Empty keeps PHP's (php.ini), which is UTC on most servers and in Docker. Changing it on a
# running install moves new visits only: see docs/configuration.md#time-zone
# Example: TIMEZONE=Europe/Stockholm
TIMEZONE=

# Clock times in the dashboard: 24h (14:00) or 12h (2 PM)
TIME_FORMAT=24h

# White-label branding (optional)
# APP_NAME=Puls
# APP_TAGLINE=See your traffic. Respect their privacy.
# APP_ACCENT=#f16272

# "Made by Webready in Sweden" in the dashboard footer (white-label shows "Powered by Puls" instead)
# FOOTER_CREDIT=false
