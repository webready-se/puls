{
    "name": "webready/puls",
    "description": "Cookieless, lightweight analytics. One PHP file + SQLite. No frameworks, no dependencies.",
    "keywords": ["analytics", "privacy", "cookieless", "sqlite", "gdpr", "tracking", "self-hosted"],
    "homepage": "https://github.com/webready-se/puls",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Nicklas Jarnesjö",
            "email": "nicklas@webready.se"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "pestphp/pest": "*"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": "git config core.hooksPath scripts/hooks",
        "post-update-cmd": "git config core.hooksPath scripts/hooks"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
